{
  "name": "public-mcp-starter",
  "version": "0.1.0",
  "description": "Starter template for fully public, no-auth MCP servers — a self-describing billboard endpoint discoverable by AI agents",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node build/server.js",
    "dev": "tsx watch src/server.ts",
    "inspect-local": "PUBLIC_HOST=localhost PORT=3000 npm run dev",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "express": "^5.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
