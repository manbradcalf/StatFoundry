# ── Network ──────────────────────────────────────────────────────────────
PUBLIC_HOST=mcp.yourdomain.com      # public hostname (Host allowlist + derived URLs)
#PUBLIC_BASE_URL=                   # override the derived https://$PUBLIC_HOST
PORT=3000
BIND_ADDR=127.0.0.1                 # keep on localhost behind nginx
#EXTRA_HOSTS=                       # comma-separated extra allowed Host values

# ── Identity / branding (rebrand your fork HERE — no code changes) ───────
MCP_NAME=public-mcp-starter         # machine name (serverInfo.name)
MCP_TITLE=Public MCP Starter        # human display name
MCP_DESCRIPTION=A fully public, no-auth MCP server.
MCP_OPERATOR=Your Company
MCP_CONTACT_EMAIL=you@yourdomain.com
MCP_WEBSITE_URL=https://yourdomain.com
#MCP_REPOSITORY_URL=https://github.com/you/your-fork
#MCP_REPOSITORY_SOURCE=github
#MCP_ICON_URL=
#MCP_ICON_MIME=image/png
#MCP_CARD_NAME=                     # override derived reverse-DNS card name
#MCP_INSTRUCTIONS=                  # override the composed initialize instructions

# Server version comes from package.json — bump it there.
